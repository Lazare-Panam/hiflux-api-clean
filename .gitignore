# ---------------------------------------------
# .gitignore for .NET / Hiflux Clean Architecture
# ---------------------------------------------

# Personal learning notes (not part of the repo)
LEARNING_LOG.md

# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
bld/
msbuild.log
msbuild.err
msbuild.wrn

# Visual Studio / Rider / VS Code IDE folders
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Rider
*.sln.iml

# Test results & coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
!packages/build/
*.nuget.props
*.nuget.targets

# .NET
project.lock.json
project.fragment.lock.json
artifacts/

# Secrets & local config (NEVER commit these)
*.env
.env
.env.*
appsettings.*.local.json
secrets.json

# Terraform
# .terraform/ holds downloaded providers (large, machine-specific) — but keep .terraform.lock.hcl tracked.
**/.terraform/*
# State can contain secrets in plaintext and is environment-specific — NEVER commit.
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# tfvars often hold secrets; commit a *.tfvars.example instead.
*.tfvars
*.tfvars.json
.terraformrc
terraform.rc

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Misc
*.tmp
*.bak
*.cache
