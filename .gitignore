# ---------------------------------------------
# .gitignore for .NET / Hiflux Clean Architecture
# ---------------------------------------------
LEARNING_LOG
# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
bld/
msbuild.log
msbuild.err
msbuild.wrn

# Visual Studio / Rider / VS Code IDE folders
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Rider
*.sln.iml

# Test results & coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
!packages/build/
*.nuget.props
*.nuget.targets

# .NET
project.lock.json
project.fragment.lock.json
artifacts/

# Secrets & local config (NEVER commit these)
*.env
.env
.env.*
appsettings.*.local.json
secrets.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Misc
*.tmp
*.bak
*.cache
